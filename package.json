{
  "name": "@ksj_project/sparrow",
  "version": "1.0.0",
  "description": "Lightweight SVG renderer and visualization primitives.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/sparrow.cjs",
  "module": "./dist/sparrow.js",
  "exports": {
    ".": {
      "import": "./dist/sparrow.js",
      "require": "./dist/sparrow.cjs"
    },
    "./plot": {
      "import": "./dist/plot.js",
      "require": "./dist/plot.cjs"
    },
    "./guide": {
      "import": "./dist/guide.js",
      "require": "./dist/guide.cjs"
    },
    "./views": {
      "import": "./dist/views.js",
      "require": "./dist/views.cjs"
    }
  },
  "license": "MIT",
  "author": "nihaokkjj",
  "homepage": "https://github.com/nihaokkjj/sparrow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nihaokkjj/sparrow.git"
  },
  "bugs": {
    "url": "https://github.com/nihaokkjj/sparrow/issues"
  },
  "keywords": [
    "svg",
    "renderer",
    "visualization",
    "chart",
    "graphics"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node ./scripts/build.mjs",
    "build:site": "vite build --config vite.site.config.js",
    "preview:site": "vite preview --config vite.site.config.js",
    "mcp": "node ./mcp/server.js",
    "rag:index": "node ./scripts/build-rag-index.mjs",
    "test": "vitest run --coverage",
    "test:browser": "vitest --config=vitest.browser.config.js run",
    "test:browser:example": "vitest --config=vitest.browser.config.js run vitest-browser-example/sparrow/RevenueCard.test.js",
    "prepare": "husky install",
    "ci": "run-s test build",
    "prepublishOnly": "run-s test build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,html}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vitest/browser-playwright": "^4.0.15",
    "@vitest/coverage-v8": "4.0.15",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "husky": "^8.0.0",
    "jsdom": "^27.3.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.7.4",
    "rolldown-vite": "^7.3.1",
    "vite": "^8.0.0",
    "vitest": "^4.0.15",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
